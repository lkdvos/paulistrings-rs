#!/bin/sh
# Refuse a commit that stages Rust files while `cargo fmt --check` reports a diff; run `cargo fmt --all` and stage again.
# Enabled per clone by `scripts/setup.sh` (`git config core.hooksPath .githooks`); bypass once with `git commit --no-verify`.
git diff --cached --name-only --diff-filter=ACMR | grep -q '\.rs$' || exit 0
if ! cargo fmt --all -- --check >/dev/null 2>&1; then
    echo "pre-commit: cargo fmt would change these files; run \`cargo fmt --all\` and stage them:" >&2
    cargo fmt --all -- --check 2>&1 | grep '^Diff in' | sed 's/^Diff in /  /; s/:[0-9]*:$//' | sort -u >&2
    exit 1
fi
